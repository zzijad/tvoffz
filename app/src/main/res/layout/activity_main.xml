<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ===================== GLAVNI EKRAN ===================== -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="40dp"
        android:paddingEnd="48dp"
        android:paddingBottom="40dp">

        <!-- Levo: pregled -->
        <LinearLayout
            android:layout_width="290dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_logo">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_power"
                        android:tint="@color/on_accent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_sub"
                        android:textColor="@color/muted"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_green" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/status_on"
                    android:textColor="@color/text"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    style="@style/Caps"
                    android:text="@string/next_label" />

                <TextView
                    android:id="@+id/tvNextTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:textColor="@color/text"
                    android:textSize="60sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNextAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/accent"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWarn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvLock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/text"
                    android:gravity="center_vertical"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvPinHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/pin_hint"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hints"
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Desno: podešavanja -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="40dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Caps"
                android:text="@string/settings_label" />

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/row_enabled" />

                <Button
                    android:id="@+id/btnEnabled"
                    style="@style/Btn"
                    android:layout_width="150dp"
                    android:layout_height="40dp" />
            </LinearLayout>

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/row_time" />

                <ImageButton
                    android:id="@+id/btnTimeMinus"
                    style="@style/IconBtn"
                    android:contentDescription="@string/earlier"
                    android:src="@drawable/ic_chevron_left" />

                <TextView
                    android:id="@+id/tvTime"
                    style="@style/RowValue" />

                <ImageButton
                    android:id="@+id/btnTimePlus"
                    style="@style/IconBtn"
                    android:contentDescription="@string/later"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/RowLabel"
                    android:drawableStart="@drawable/ic_lock"
                    android:text="@string/row_lock" />

                <ImageButton
                    android:id="@+id/btnLockMinus"
                    style="@style/IconBtn"
                    android:contentDescription="@string/earlier"
                    android:src="@drawable/ic_chevron_left" />

                <TextView
                    android:id="@+id/tvLockTime"
                    style="@style/RowValue" />

                <ImageButton
                    android:id="@+id/btnLockPlus"
                    style="@style/IconBtn"
                    android:contentDescription="@string/later"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout
                style="@style/Row"
                android:paddingEnd="8dp">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/row_action" />

                <Button
                    android:id="@+id/btnShutdown"
                    style="@style/Btn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:drawableStart="@drawable/ic_power"
                    android:text="@string/action_shutdown" />

                <Button
                    android:id="@+id/btnHome"
                    style="@style/Btn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:drawableStart="@drawable/ic_home"
                    android:text="@string/action_home" />
            </LinearLayout>

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/row_secs" />

                <ImageButton
                    android:id="@+id/btnSecMinus"
                    style="@style/IconBtn"
                    android:contentDescription="@string/earlier"
                    android:src="@drawable/ic_chevron_left" />

                <TextView
                    android:id="@+id/tvSecs"
                    style="@style/RowValue" />

                <ImageButton
                    android:id="@+id/btnSecPlus"
                    style="@style/IconBtn"
                    android:contentDescription="@string/later"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/row_days" />

                <Button
                    android:id="@+id/day0"
                    style="@style/Btn.Day"
                    android:text="P" />

                <Button
                    android:id="@+id/day1"
                    style="@style/Btn.Day"
                    android:text="U" />

                <Button
                    android:id="@+id/day2"
                    style="@style/Btn.Day"
                    android:text="S" />

                <Button
                    android:id="@+id/day3"
                    style="@style/Btn.Day"
                    android:text="Č" />

                <Button
                    android:id="@+id/day4"
                    style="@style/Btn.Day"
                    android:text="P" />

                <Button
                    android:id="@+id/day5"
                    style="@style/Btn.Day"
                    android:text="S" />

                <Button
                    android:id="@+id/day6"
                    style="@style/Btn.Day"
                    android:text="N" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTest"
                    style="@style/Btn.Outline"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_play"
                    android:text="@string/btn_test" />

                <Button
                    android:id="@+id/btnPin"
                    style="@style/Btn.Outline"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_key"
                    android:text="@string/pin_change" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ============ SERVIS NIJE UKLJUČEN ============ -->
    <LinearLayout
        android:id="@+id/setupContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="64dp"
        android:paddingTop="56dp"
        android:paddingEnd="64dp"
        android:paddingBottom="56dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning"
                    android:tint="@color/accent" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/setup_title"
                android:textColor="@color/text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/setup_desc"
                android:textColor="@color/muted"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step_num"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/setup_step1"
                    android:textColor="@color/text"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step_num"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/setup_step2"
                    android:textColor="@color/text"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step_num"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/setup_step3"
                    android:textColor="@color/text"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="26dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOpenSettings"
                    style="@style/Btn.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/btn_open_settings" />

                <Button
                    android:id="@+id/btnLater"
                    style="@style/Btn.Outline"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/btn_later" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
